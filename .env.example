# ===================================================================
# TEAMJOY HR MANAGEMENT - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and replace the placeholder values with your
# local secrets. DO NOT commit your real .env file to Git!
# ===================================================================

# ── PostgreSQL Database Credentials ──────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hrmanagement
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# ── JWT Authentication Secret (Must be 64-char hex / 256-bit key) ───
APP_JWT_SECRET=your_jwt_secret_hex_256_bit_here
APP_JWT_EXPIRATION_MS=86400000

# ── Postmark Email Integration ────────────────────────────────────────
# Server Token from your Postmark Server -> Settings -> API Tokens
POSTMARK_SERVER_TOKEN=your_postmark_server_token_here
POSTMARK_SENDER_EMAIL=your_sender_email_here@company.com
POSTMARK_ENABLED=true
POSTMARK_MESSAGE_STREAM=outbound

# ── Google Gemini Pro AI Configuration ──────────────────────────────
# Obtain your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Avatar Assistant Master Feature Toggle ───────────────────────────
AVATAR_ENABLED=true
